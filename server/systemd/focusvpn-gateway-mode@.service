[Unit]
Description=Switch FocusVPN gateway mode (%i)
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/focusvpn/focusvpn.env
ExecStart=/usr/bin/python3 /usr/local/libexec/focusvpn-gateway-mode %i