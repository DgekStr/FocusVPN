# Copy to /etc/focusvpn/focusvpn.env and adjust for the target server.
SING_BOX_ADMIN_HOST=0.0.0.0
SING_BOX_ADMIN_PORT=9443
# Optional extra IPv4 access network; 0.0.0.0/0 permits all sources. HTTP is unencrypted.
FOCUSVPN_ADMIN_NETWORK=
FOCUSVPN_WG_INTERFACE=wg0
FOCUSVPN_WG_NETWORK=10.8.0.0/24
FOCUSVPN_WG_SERVER_KEEPALIVE=10
FOCUSVPN_LAN_NETWORK=192.168.0.0/24
FOCUSVPN_MANAGEMENT_NETWORK=10.1.17.0/24
FOCUSVPN_WG_EASY_API_URL=http://127.0.0.1:51821
FOCUSVPN_WG_FALLBACK_GATEWAY=192.168.0.6