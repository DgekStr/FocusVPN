server {
    listen 80;
    listen [::]:80;
    server_name vpn.focuslens.dev;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name vpn.focuslens.dev;

    ssl_certificate /etc/letsencrypt/live/vpn.focuslens.dev/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vpn.focuslens.dev/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://192.168.0.39:9443;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        client_max_body_size 1m;
        proxy_read_timeout 120s;
        proxy_redirect off;
    }
}