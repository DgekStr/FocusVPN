#!/usr/bin/env python3
import subprocess
import sys

BASE = '/etc/sing-box/tproxy.nft'
LOADER = '/usr/local/libexec/load-ru-zone.py'
NFT = '/usr/sbin/nft'


def run(args):
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120, check=False)
    if result.returncode:
        raise SystemExit(result.stdout.strip() or 'gateway command failed')


def run_optional(args):
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30, check=False)


if len(sys.argv) != 2 or sys.argv[1] not in ('start', 'stop'):
    raise SystemExit('usage: sing-box-gateway {start|stop}')

if sys.argv[1] == 'start':
    run_optional(['/usr/sbin/modprobe', 'nf_tproxy_ipv4'])
    run_optional(['/usr/sbin/modprobe', 'nft_tproxy'])
    run(['/usr/sbin/ip', 'route', 'replace', 'local', '0.0.0.0/0', 'dev', 'lo', 'table', '100'])
    rules = subprocess.run(['/usr/sbin/ip', 'rule', 'show'], text=True, stdout=subprocess.PIPE, check=False).stdout
    if 'fwmark 0x1/0x1 lookup 100' not in rules:
        run(['/usr/sbin/ip', 'rule', 'add', 'fwmark', '0x1/0x1', 'lookup', '100', 'priority', '100'])
    run([NFT, 'delete', 'table', 'inet', 'singbox_vless']) if subprocess.run([NFT, 'list', 'table', 'inet', 'singbox_vless'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False).returncode == 0 else None
    run([NFT, '-f', BASE])
    run(['/usr/bin/python3', LOADER])
else:
    subprocess.run([NFT, 'delete', 'table', 'inet', 'singbox_vless'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(['/usr/sbin/ip', 'rule', 'del', 'fwmark', '0x1/0x1', 'lookup', '100', 'priority', '100'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(['/usr/sbin/ip', 'route', 'flush', 'table', '100'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
