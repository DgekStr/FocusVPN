[Unit]
Description=VPN-only sing-box VLESS administration panel
Wants=network-online.target
After=network-online.target sing-box.service

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=-/etc/focusvpn/focusvpn.env
ExecStart=/usr/bin/python3 /opt/sing-box-admin/app.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
BindReadOnlyPaths=/proc/uptime
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
ReadWritePaths=/etc/focusvpn /etc/sing-box /etc/sing-box-admin /etc/sing-box-happ-server /etc/wireguard /mnt/stat
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER

[Install]
WantedBy=multi-user.target
