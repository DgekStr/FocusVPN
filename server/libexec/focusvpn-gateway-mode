#!/usr/bin/env python3
import ipaddress
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


SERVER_WG_INTERFACE = os.environ.get('FOCUSVPN_WG_INTERFACE', 'wg0')
MODE_PATH = Path('/etc/focusvpn/gateway-mode.json')
VPN_NETWORK = ipaddress.ip_network(os.environ.get('FOCUSVPN_WG_NETWORK', '10.8.0.0/24'), strict=False)
IPTABLES = '/usr/sbin/iptables'


def run(args, optional=False, input_text=None):
    result = subprocess.run(args, input=input_text, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=60, check=False)
    if result.returncode and not optional:
        raise RuntimeError(result.stdout.strip() or 'gateway mode command failed')
    return result


def systemctl(action, unit, optional=False):
    return run(['/usr/bin/systemctl', action, unit], optional=optional)


def load_mode_state():
    try:
        return json.loads(MODE_PATH.read_text(encoding='utf-8'))
    except (OSError, json.JSONDecodeError):
        return {}


def write_json(path, payload, mode):
    descriptor, temporary = tempfile.mkstemp(prefix='.focusvpn-mode-', dir=path.parent)
    try:
        with os.fdopen(descriptor, 'w', encoding='utf-8') as handle:
            json.dump(payload, handle, indent=2, ensure_ascii=False)
            handle.write('\n')
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    except Exception:
        Path(temporary).unlink(missing_ok=True)
        raise


def remove_added_forwarding_rules(rules):
    for rule in reversed(rules):
        removal = list(rule)
        removal[removal.index('-C')] = '-D'
        run(removal, optional=True)


def verify_default_gateway_route(require_selected=True, install_missing=False):
    defaults = json.loads(run(['/usr/sbin/ip', '-j', '-4', 'route', 'show', 'default']).stdout)
    if not defaults:
        raise RuntimeError('Основной IPv4-шлюз сервера не настроен.')
    default = min(defaults, key=lambda item: item.get('metric', 0))
    selected = []
    for source in VPN_NETWORK.hosts():
        probe = run(['/usr/sbin/ip', '-j', '-4', 'route', 'get', '1.1.1.1', 'from', str(source), 'iif', SERVER_WG_INTERFACE], optional=True)
        if probe.returncode == 0:
            selected = json.loads(probe.stdout)
            if selected:
                break
    if not selected:
        raise RuntimeError('Не удалось определить маршрут клиентского трафика.')
    if require_selected and not any(item.get('dev') == selected[0].get('dev') and item.get('gateway') == selected[0].get('gateway') for item in defaults):
        raise RuntimeError('Трафик клиентов не использует основной шлюз сервера.')
    device = default.get('dev', '')
    if not device:
        raise RuntimeError('У основного шлюза сервера не определён сетевой интерфейс.')
    rules = (
        [IPTABLES, '-C', 'FORWARD', '-i', SERVER_WG_INTERFACE, '-o', device, '-s', str(VPN_NETWORK), '-j', 'ACCEPT'],
        [IPTABLES, '-C', 'FORWARD', '-i', device, '-o', SERVER_WG_INTERFACE, '-d', str(VPN_NETWORK), '-m', 'conntrack', '--ctstate', 'RELATED,ESTABLISHED', '-j', 'ACCEPT'],
        [IPTABLES, '-t', 'nat', '-C', 'POSTROUTING', '-s', str(VPN_NETWORK), '-o', device, '-j', 'MASQUERADE'],
    )
    forwarding = run(['/usr/sbin/sysctl', '-n', 'net.ipv4.ip_forward'])
    if forwarding.stdout.strip() != '1':
        raise RuntimeError('IPv4 forwarding выключен на сервере.')
    added = []
    try:
        for rule in rules:
            if run(rule, optional=True).returncode == 0:
                continue
            if not install_missing:
                raise RuntimeError('Не настроены FORWARD/NAT правила для выхода через основной шлюз сервера.')
            insertion = list(rule)
            operation = insertion.index('-C')
            insertion[operation] = '-I'
            insertion.insert(operation + 2, '1')
            run(insertion)
            added.append(rule)
            if run(rule, optional=True).returncode != 0:
                raise RuntimeError('Не удалось проверить добавленные FORWARD/NAT правила.')
    except Exception:
        remove_added_forwarding_rules(added)
        raise
    result = dict(selected[0] if require_selected else default)
    if install_missing:
        result['_added_forwarding'] = added
    return result


def save_mode(mode):
    MODE_PATH.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    write_json(MODE_PATH, {'mode': mode}, 0o600)


def apply_vless():
    systemctl('start', 'sing-box.service')
    systemctl('start', 'sing-box-happ-server.service')
    save_mode('vless')


def apply_default():
    previous_state = load_mode_state()
    previous_mode = previous_state.get('mode', 'vless')
    if previous_mode not in ('vless', 'default'):
        previous_mode = 'vless'
    prepared_route = verify_default_gateway_route(require_selected=False, install_missing=True)
    added_rules = prepared_route.get('_added_forwarding', [])
    try:
        systemctl('stop', 'sing-box.service')
        systemctl('start', 'sing-box-happ-server.service')
        verify_default_gateway_route()
    except Exception:
        remove_added_forwarding_rules(added_rules)
        if previous_mode == 'vless':
            apply_vless()
        else:
            systemctl('stop', 'sing-box.service', optional=True)
            systemctl('start', 'sing-box-happ-server.service')
            save_mode('default')
        raise
    save_mode('default')


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ('vless', 'default', 'restore'):
        raise SystemExit('usage: focusvpn-gateway-mode {vless|default|restore}')
    mode = sys.argv[1]
    if mode == 'restore':
        try:
            saved = json.loads(MODE_PATH.read_text(encoding='utf-8')).get('mode')
        except (OSError, json.JSONDecodeError, AttributeError):
            saved = 'vless'
        mode = saved if saved in ('vless', 'default') else 'vless'
    if mode == 'default':
        apply_default()
    else:
        apply_vless()


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, subprocess.TimeoutExpired) as error:
        raise SystemExit(str(error)) from error